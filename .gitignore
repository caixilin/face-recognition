*.py[cod]
*.egg-info/
.venv/
venv/
envs/
*.conda/

# 模型权重与数据（不入库）
# 注意：必须用 ** 递归匹配，权重实际位于 models/<子目录>/ 下
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.onnx
data/**

# SDK 部署权重（过大，不入库，本地保留）
ev_sdk/model/**/*.pt
ev_sdk/model/**/*.pth

# 训练产物（不入库）
train/models/**
train/log/**
train/result-graphs/**
!train/models/.gitkeep
!train/log/.gitkeep
!train/result-graphs/.gitkeep

